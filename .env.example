# Database Configuration
# Local default: sqlite:///./careerai.db
# Production example: postgresql://careerai_user:password@localhost:5432/careerai
DATABASE_URL=sqlite:///./careerai.db

# Security & Authentication
JWT_SECRET=careerai-super-secret-jwt-key-2026-production-ready-auth
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google SSO / Chrome Sign-In (Optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# AI Configuration
# Options: demo | gemini | openai
DEMO_MODE=true
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# File Storage
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
